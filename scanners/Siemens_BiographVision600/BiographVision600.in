# >>>> INPUT FILE FOR MCGPU-PET v0.1 — Siemens Biograph Vision 600 >>>>>>>>>>>>
#
#  Scanner: Siemens Biograph Vision 600 PET/CT
#  Template prepared with verified parameters from:
#    - van Sluis et al., J Nucl Med, 2019;60(7):1031-1036
#    - Prenosil et al., J Nucl Med, 2022;63(3):476-484
#
#  NOTE: Adjust phantom file, material files, acquisition time, and output
#        paths according to your specific simulation requirements.
#
#                  @file    BiographVision600.in
#                  @date    2026-02-24
#

#[SECTION SIMULATION CONFIG v.2016-07-05]
0                               # RANDOM SEED (0 = use current time as seed)
0                               # GPU NUMBER TO USE WHEN MPI IS NOT USED
32                              # GPU THREADS PER CUDA BLOCK (multiple of 32)
1.0                             # FACTOR TO SCALE THE INPUT MATERIAL DENSITY


#[SECTION SOURCE PET SCAN v.2017-03-14]
60.0                            # TOTAL PET SCAN ACQUISITION TIME [seconds]  (adjust as needed)
9504.0                          # ISOTOPE MEAN LIFE [s]  (F-18: t1/2=109.77min -> tau=9504s)
   1    0.0   # !!INPUT NOT USED: Activity read from input voxel file as 3rd column!!
   0    0.0

 
#[SECTION PHASE SPACE FILE v.2016-07-05]
 BiographVision600_output.psf    # OUTPUT PHASE SPACE FILE NAME
 0.0  0.0  0.0  26.3  -39.0     # CYLINDRIC DETECTOR: X, Y, Z (center), H=26.3cm (axial FOV), RADIUS=-39.0cm (negative -> auto-center on phantom)
 150000000                       # PHASE SPACE FILE SIZE (MAX NUMBER OF ELEMENTS)
 0                               # REPORT TRUES (1), SCATTER (2), OR BOTH (0)
 0                               # REPORT PSF (1), SINOGRAM (2) or BOTH (0)


#[SECTION DOSE DEPOSITION v.2012-12-12]
YES                             # TALLY MATERIAL DOSE? [YES/NO]
NO                              # TALLY 3D VOXEL DOSE? [YES/NO]
BiographVision600_dose.dat      # OUTPUT VOXEL DOSE FILE NAME
  1  128                        # VOXEL DOSE ROI: X-index min max
  1  128                        # VOXEL DOSE ROI: Y-index min max
  1  159                        # VOXEL DOSE ROI: Z-index min max


#[SECTION ENERGY PARAMETERS v.2019-04-25]
0.093         # ENERGY RESOLUTION OF THE CRYSTALS (9.3% FWHM at 511 keV — Vision 600 measured value)
435000.0      # ENERGY WINDOW LOW  [eV]  (435 keV — Vision 600 clinical default)
585000.0      # ENERGY WINDOW HIGH [eV]  (585 keV — Vision 600 clinical default)


#[SECTION SINOGRAM PARAMETERS v.2019-04-25]
26.3   # AXIAL FIELD OF VIEW (FOVz) [cm]  — Vision 600: 26.3 cm
80     # NUMBER OF ROWS                   — 80 crystal rings
760    # TOTAL NUMBER OF CRYSTALS         — 760 crystals per ring
380    # NUMBER OF ANGULAR BINS           — NCRYSTALS/2
339    # NUMBER OF RADIAL BINS            — Adequate sampling for 70 cm transaxial FOV
159    # NUMBER OF Z SLICES               — 2*NROWS - 1
256    # IMAGE RESOLUTION                 — Reconstruction matrix size
700    # NUMBER OF ENERGY BINS (NE)
79     # MAXIMUM RING DIFFERENCE (MRD)    — NROWS - 1
11     # SPAN


#[SECTION VOXELIZED GEOMETRY FILE v.2009-11-30]
phantom.vox                     # VOXEL GEOMETRY FILE (adjust path to your phantom)


#[SECTION MATERIAL FILE LIST v.2009-11-30]
./materials/air_5-515keV.mcgpu.gz             # 1
./materials/water_5-515keV.mcgpu.gz           # 2
#
#
# >>>> END INPUT FILE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
