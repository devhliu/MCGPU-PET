# >>>> INPUT FILE FOR MCGPU-PET v0.1 — Vision 600 NEMA IQ Phantom Preset >>>>>>
#
#  Scanner: Siemens Biograph Vision 600 PET/CT
#  Phantom: NEMA NU 2-2018 Image Quality (IQ) Phantom
#
#  The NEMA IQ phantom is a torso-shaped fillable phantom with:
#    - A uniform warm background (body)
#    - 6 hot spheres (inner diameters: 10, 13, 17, 22, 28, 37 mm)
#    - All spheres filled with 8:1 sphere-to-background activity ratio
#    - A cylindrical lung insert (low density, no activity)
#
#  NOTE: You must create a matching NEMA IQ voxelized phantom (.vox) file.
#        The example_phantom_generator.py script can be adapted for this.
#
#                  @file    BiographVision600_NEMA_IQ.in
#                  @date    2026-02-24
#

#[SECTION SIMULATION CONFIG v.2016-07-05]
0                               # RANDOM SEED (0 = random seed from clock)
0                               # GPU NUMBER TO USE WHEN MPI IS NOT USED
128                             # GPU THREADS PER CUDA BLOCK (multiple of 32)
1.0                             # FACTOR TO SCALE THE INPUT MATERIAL DENSITY


#[SECTION SOURCE PET SCAN v.2017-03-14]
300.0                           # TOTAL PET SCAN ACQUISITION TIME [s] (5 min — typical NEMA IQ scan)
9504.0                          # ISOTOPE MEAN LIFE [s] (F-18: t½ = 109.77 min → τ = 9504 s)
   1    0.0   # !!INPUT NOT USED: Activity read from input voxel file as 3rd column!!
   0    0.0


#[SECTION PHASE SPACE FILE v.2016-07-05]
 Vision600_NEMA_IQ.psf           # OUTPUT PHASE SPACE FILE NAME
 0.0  0.0  0.0  26.3  -39.0     # CYLINDRIC DETECTOR: X, Y, Z, H=26.3cm, R=-39.0cm (auto-center)
 300000000                       # PHASE SPACE FILE SIZE (MAX ELEMENTS — increased for 5 min scan)
 0                               # REPORT TRUES (1), SCATTER (2), OR BOTH (0)
 0                               # REPORT PSF (1), SINOGRAM (2) or BOTH (0)


#[SECTION DOSE DEPOSITION v.2012-12-12]
NO                              # TALLY MATERIAL DOSE? [YES/NO]
NO                              # TALLY 3D VOXEL DOSE? [YES/NO]
Vision600_NEMA_IQ_dose.dat      # OUTPUT VOXEL DOSE FILE NAME
  1  256                        # VOXEL DOSE ROI: X-index min max
  1  256                        # VOXEL DOSE ROI: Y-index min max
  1  159                        # VOXEL DOSE ROI: Z-index min max


#[SECTION ENERGY PARAMETERS v.2019-04-25]
0.093         # ENERGY RESOLUTION (9.3% FWHM at 511 keV)
435000.0      # ENERGY WINDOW LOW  [eV] (435 keV)
585000.0      # ENERGY WINDOW HIGH [eV] (585 keV)


#[SECTION SINOGRAM PARAMETERS v.2019-04-25]
26.3   # AXIAL FIELD OF VIEW (FOVz) [cm]
80     # NUMBER OF ROWS
760    # TOTAL NUMBER OF CRYSTALS
380    # NUMBER OF ANGULAR BINS
339    # NUMBER OF RADIAL BINS
159    # NUMBER OF Z SLICES
256    # IMAGE RESOLUTION
700    # NUMBER OF ENERGY BINS (NE)
79     # MAXIMUM RING DIFFERENCE (MRD)
11     # SPAN


#[SECTION VOXELIZED GEOMETRY FILE v.2009-11-30]
NEMA_IQ_phantom.vox             # VOXEL GEOMETRY FILE (NEMA IQ phantom — user must provide)


#[SECTION MATERIAL FILE LIST v.2009-11-30]
./materials/air_5-515keV.mcgpu.gz             # 1 — Air (lung insert + exterior)
./materials/water_5-515keV.mcgpu.gz           # 2 — Water (approximation for phantom body)
#
#
# >>>> END INPUT FILE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
